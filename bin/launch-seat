#!/usr/bin/env bash
# Launch one agent seat in a terminal on the agent-house workspace.
# Args: room_id role program cwd prompt workspace
set -euo pipefail

ROOM_ID="${1:?room id}"
ROLE="${2:?role}"
PROGRAM="${3:?program}"
CWD="${4:?cwd}"
PROMPT="${5:?prompt}"
WORKSPACE="${6:-agent-house}"

export AGENT_ROOM_ID="$ROOM_ID"
export AGENT_ROOM_ROLE="$ROLE"
export AGENT_ROOM_NAME="${AGENT_ROOM_NAME:-$ROLE}"
export AGENT_ROOM_CWD="$CWD"

if [[ ! -d $CWD ]]; then
  mkdir -p "$CWD"
fi
cd "$CWD"

if command -v hyprctl >/dev/null 2>&1; then
  workspace_target="$WORKSPACE"
  if [[ ! "$workspace_target" =~ ^[0-9]+$ && "$workspace_target" != name:* && "$workspace_target" != special:* ]]; then
    workspace_target="name:$workspace_target"
  fi
  hyprctl dispatch workspace "$workspace_target" >/dev/null 2>&1 || true
fi

launch_tui=(omarchy-launch-tui "--app-id=org.omarchy.agent-room.${ROLE}")
if ! command -v omarchy-launch-tui >/dev/null 2>&1; then
  launch_tui=(xdg-terminal-exec --app-id="org.omarchy.agent-room.${ROLE}" -e)
fi

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
exec "${launch_tui[@]}" python3 "$ROOT/agent_room.py" exec-seat "$PROGRAM" "$PROMPT"
